      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "type": "short",
      "sourceSet": "derived"
    },
    {
      "text": "世界政策を推進したドイツ皇帝は【ヴィルヘルム2世】である。",
      "tags": [
        "No21",
        "第15章",
        "帝国主義",
        "ドイツ",
        "長文分解"
      ],
      "gradingMode": "loose",
      "id": "qb7vbk0lmvgd87qh0q",
      "createdAt": "2026-11-02T00:44:55.000Z",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "type": "short",
      "sourceSet": "derived"
    },
    {
      "text": "米西戦争でアメリカがカリブ海に獲得した地域は【プエルトリコ】である。",
      "tags": [
        "No21",
        "第15章",
        "帝国主義",
        "米西戦争",
        "長文分解"
      ],
      "gradingMode": "loose",
      "id": "05coo0jysv0j435jse",
      "createdAt": "2026-11-02T00:44:55.000Z",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "type": "short",
      "sourceSet": "derived"
    },
    {
      "text": "米西戦争でアメリカが太平洋に獲得した地域は【グアム】である。",
      "tags": [
        "No21",
        "第15章",
        "帝国主義",
        "米西戦争",
        "長文分解"
      ],
      "gradingMode": "loose",
      "id": "5hnt0ubqs0co1sxx7x",
      "createdAt": "2026-11-02T00:44:55.000Z",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "type": "short",
      "sourceSet": "derived"
    },
    {
      "text": "1898年にアメリカが併合した太平洋の諸島は【ハワイ】である。",
      "tags": [
        "No21",
        "第15章",
        "帝国主義",
        "アメリカ",
        "長文分解"
      ],
      "gradingMode": "loose",
      "id": "vf3sphbc7mc61opl75",
      "createdAt": "2026-11-02T00:44:55.000Z",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "type": "short",
      "sourceSet": "derived"
    },
    {
      "text": "アメリカが運河建設のため独立させた国は【パナマ】である。",
      "tags": [
        "No21",
        "第15章",
        "帝国主義",
        "アメリカ",
        "長文分解"
      ],
      "gradingMode": "loose",
      "id": "777x4tomv0tg8k12hy",
      "createdAt": "2026-11-02T00:44:55.000Z",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "type": "short",
      "sourceSet": "derived"
    },
    {
      "text": "電力・石油を動力源とする重化学工業中心の技術革新を【第2次産業革命】という。",
      "tags": [
        "No21",
        "第15章",
        "帝国主義",
        "産業革命",
        "長文分解"
      ],
      "gradingMode": "loose",
      "id": "n4lyftj7m8xolrrduj",
      "createdAt": "2026-11-02T00:44:55.000Z",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "type": "short",
      "sourceSet": "derived"
    },
    {
      "text": "1889年にワシントンで開かれた会議は【第1回パン＝アメリカ会議】である。",
      "tags": [
        "No21",
        "第15章",
        "帝国主義",
        "アメリカ",
        "長文分解"
      ],
      "gradingMode": "loose",
      "id": "e9tebt3coivrqe8lqf",
      "createdAt": "2026-11-02T00:44:55.000Z",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "type": "short",
      "sourceSet": "derived"
    },
    {
      "text": "第2次バルカン戦争で敗れ同盟国側に接近した国は【ブルガリア】である。",
      "tags": [
        "No21",
        "第16章",
        "第一次世界大戦",
        "バルカン",
        "長文分解"
      ],
      "gradingMode": "loose",
      "id": "n1g208jxpaeqh6535z",
      "createdAt": "2026-11-02T00:44:55.000Z",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "type": "short",
      "sourceSet": "derived"
    },
    {
      "text": "1925年に締結された西ヨーロッパの地域的安全保障条約は【ロカルノ条約】である。",
      "tags": [
        "No21",
        "第16章",
        "第一次世界大戦",
        "国際協調",
        "長文分解"
      ],
      "gradingMode": "loose",
      "id": "kdtd7s0ntqk1mb7f3u",
      "createdAt": "2026-11-02T00:44:55.000Z",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "type": "short",
      "sourceSet": "derived"
    },
    {
      "text": "1921年に導入された政策は【新経済政策（ネップ）】である。",
      "tags": [
        "No21",
        "第16章",
        "第一次世界大戦",
        "ソ連",
        "長文分解"
      ],
      "gradingMode": "loose",
      "id": "s3fpp02lgopymt0vk2",
      "createdAt": "2026-11-02T00:44:55.000Z",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "type": "short",
      "sourceSet": "derived"
    },
    {
      "text": "人員・物資を全面動員する戦争を【総力戦】という。",
      "tags": [
        "No21",
        "第16章",
        "第一次世界大戦",
        "戦争",
        "長文分解"
      ],
      "gradingMode": "loose",
      "id": "cgiurafubhr271p8xv",
      "createdAt": "2026-11-02T00:44:55.000Z",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "type": "short",
      "sourceSet": "derived"
    },
    {
      "text": "キール軍港の反乱後、ドイツ皇帝【ヴィルヘルム2世】は退位した。",
      "tags": [
        "No21",
        "第16章",
        "第一次世界大戦",
        "ドイツ革命",
        "長文分解"
      ],
      "gradingMode": "loose",
      "id": "sxioup23zoa2yy06cf",
      "createdAt": "2026-11-02T00:44:55.000Z",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "type": "short",
      "sourceSet": "derived"
    },
    {
      "text": "1928年に開始された重工業化政策は【第1次五カ年計画】である。",
      "tags": [
        "No21",
        "第16章",
        "第一次世界大戦",
        "ソ連",
        "長文分解"
      ],
      "gradingMode": "loose",
      "id": "e4rllu81mkwtd831k2",
      "createdAt": "2026-11-02T00:44:55.000Z",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "type": "short",
      "sourceSet": "derived"
    },
    {
      "text": "南北戦争で南軍を率いた司令官は【リー】である。",
      "tags": [
        "No21",
        "第13章",
        "南北戦争",
        "短文問題",
        "長文分解"
      ],
      "gradingMode": "loose",
      "type": "short",
