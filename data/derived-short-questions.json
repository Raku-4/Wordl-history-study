      "lastStudiedAt": null,
      "lastStudyMode": null,
      "sourceSet": "derived"
    },
    {
      "text": "南北戦争後、解放された黒人の多くは土地を与えられず【シェア＝クロッパー】となった。",
      "tags": [
        "No21",
        "第13章",
        "南北戦争",
        "短文問題",
        "長文分解"
      ],
      "gradingMode": "loose",
      "type": "short",
      "id": "derived-3b4b83208638f6bc",
      "createdAt": "2026-11-02T20:54:00+09:00",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "sourceSet": "derived"
    },
    {
      "text": "アメリカ国内のフロンティア消滅が宣言された年は【1890年】である。",
      "tags": [
        "No21",
        "第15章",
        "帝国主義",
        "アメリカ",
        "短文問題",
        "長文分解"
      ],
      "gradingMode": "loose",
      "type": "short",
      "id": "derived-120a0fba13771109",
      "createdAt": "2026-11-02T20:54:00+09:00",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "sourceSet": "derived"
    },
    {
      "text": "万国平和会議が開かれた都市は【ハーグ】である。",
      "tags": [
        "No21",
        "第16章",
        "第一次世界大戦",
        "国際関係",
        "短文問題",
        "長文分解"
      ],
      "gradingMode": "loose",
      "type": "short",
      "id": "derived-5f6542c90b4bc9eb",
      "createdAt": "2026-11-02T20:54:00+09:00",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "sourceSet": "derived"
    },
    {
      "text": "万国平和会議の開催を提唱したロシア皇帝は【ニコライ2世】である。",
      "tags": [
        "No21",
        "第16章",
        "第一次世界大戦",
        "国際関係",
        "短文問題",
        "長文分解"
      ],
      "gradingMode": "loose",
      "type": "short",
      "id": "derived-dcde55c393015511",
      "createdAt": "2026-11-02T20:54:00+09:00",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "sourceSet": "derived"
    },
    {
      "text": "万国平和会議が開催された年は【1899年】と【1907年】である。",
      "tags": [
        "No21",
        "第16章",
        "第一次世界大戦",
        "国際関係",
        "短文問題",
        "長文分解"
      ],
      "gradingMode": "loose",
      "type": "short",
      "id": "derived-1bca6d9456e6eadf",
      "createdAt": "2026-11-02T20:54:00+09:00",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "sourceSet": "derived"
    },
    {
      "text": "第一次世界大戦でアメリカ大統領ウィルソンが掲げた理念の一つは【民主主義の擁護】である。",
      "tags": [
        "No21",
        "第16章",
        "第一次世界大戦",
        "アメリカ参戦",
        "短文問題",
        "長文分解"
      ],
      "gradingMode": "loose",
      "type": "short",
      "id": "derived-bc9444a03c941a8f",
      "createdAt": "2026-11-02T20:54:00+09:00",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "sourceSet": "derived"
    },
    {
      "text": "ウィルソンは戦後の国際平和機構として【国際連盟】の設立を構想した。",
      "tags": [
        "No21",
        "第16章",
        "第一次世界大戦",
        "国際秩序",
        "短文問題",
        "長文分解"
      ],
      "gradingMode": "loose",
      "type": "short",
      "id": "derived-ed2f83f52a14be11",
      "createdAt": "2026-11-02T20:54:00+09:00",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "sourceSet": "derived"
    },
    {
      "text": "総力戦下では食料や生活必需品に【配給制】が導入された。",
      "tags": [
        "No21",
        "第16章",
        "第一次世界大戦",
        "総力戦",
        "短文問題",
        "長文分解"
      ],
      "gradingMode": "loose",
      "type": "short",
      "id": "derived-8306f488e5bc8bdf",
      "createdAt": "2026-11-02T20:54:00+09:00",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "sourceSet": "derived"
    },
    {
      "text": "総力戦下では出征した男性に代わり【女性】が工場などで働いた。",
      "tags": [
        "No21",
        "第16章",
        "第一次世界大戦",
        "総力戦",
        "短文問題",
        "長文分解"
      ],
      "gradingMode": "loose",
      "type": "short",
      "id": "derived-2aaf524886613dc4",
      "createdAt": "2026-11-02T20:54:00+09:00",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "sourceSet": "derived"
    },
    {
      "text": "第一次世界大戦の西部戦線では【塹壕戦】が続いた。",
      "tags": [
        "No21",
        "第16章",
        "第一次世界大戦",
        "総力戦",
        "短文問題",
        "長文分解"
      ],
      "gradingMode": "loose",
      "type": "short",
      "id": "derived-6dd660a01eae0dbc",
      "createdAt": "2026-11-02T20:54:00+09:00",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "sourceSet": "derived"
    },
    {
      "text": "オーストリアに対抗してバルカン同盟の結成を支援した国は【ロシア】である。",
      "tags": [
        "No21",
        "第16章",
        "第一次世界大戦",
        "バルカン",
        "短文問題",
        "長文分解"
      ],
      "gradingMode": "loose",
      "type": "short",
      "id": "derived-66c94b5b4c53f2a7",
      "createdAt": "2026-11-02T20:54:00+09:00",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "sourceSet": "derived"
    },
    {
      "text": "バルカン同盟が戦った相手は【オスマン帝国】である。",
      "tags": [
        "No21",
        "第16章",
        "第一次世界大戦",
        "バルカン",
        "短文問題",
        "長文分解"
      ],
      "gradingMode": "loose",
      "type": "short",
      "id": "derived-f7dab8b64d77e161",
      "createdAt": "2026-11-02T20:54:00+09:00",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "sourceSet": "derived"
    },
    {
      "text": "キール軍港の水兵反乱をきっかけに【ドイツ革命】が起こった。",
      "tags": [
        "No21",
        "第16章",
        "第一次世界大戦",
        "ドイツ革命",
        "短文問題",
        "長文分解"
      ],
      "gradingMode": "loose",
      "type": "short",
      "id": "derived-24f7d83d956eaa53",
      "createdAt": "2026-11-02T20:54:00+09:00",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "sourceSet": "derived"
    },
    {
      "text": "ドイツ革命によって【ドイツ帝政】が終わった。",
      "tags": [
        "No21",
        "第16章",
        "第一次世界大戦",
        "ドイツ革命",
        "短文問題",
        "長文分解"
      ],
      "gradingMode": "loose",
      "type": "short",
      "id": "derived-aace20c98157226e",
      "createdAt": "2026-11-02T20:54:00+09:00",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "sourceSet": "derived"
    },
    {
      "text": "ロカルノ条約の締結に貢献したフランスの政治家は【ブリアン】である。",
      "tags": [
        "No21",
        "第16章",
        "第一次世界大戦",
        "国際協調",
        "短文問題",
        "長文分解"
      ],
      "gradingMode": "loose",
      "type": "short",
      "id": "derived-c308af23183618e8",
      "createdAt": "2026-11-02T20:54:00+09:00",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "sourceSet": "derived"
    },
    {
      "text": "ロカルノ条約を推進したドイツ外相は【シュトレーゼマン】である。",
      "tags": [
        "No21",
        "第16章",
        "第一次世界大戦",
        "国際協調",
        "短文問題",
        "長文分解"
      ],
      "gradingMode": "loose",
      "type": "short",
      "id": "derived-727c151cc8bd1db8",
      "createdAt": "2026-11-02T20:54:00+09:00",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "sourceSet": "derived"
    },
    {
      "text": "1865年、連邦軍が陥落させた南部の首都は【リッチモンド】である。",
      "tags": [
        "No21",
        "第13章",
        "南北戦争",
        "長文分解"
      ],
      "gradingMode": "loose",
      "id": "opn7hgm3dd39t2n4aw",
      "createdAt": "2026-11-02T00:44:55.000Z",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "type": "short",
      "sourceSet": "derived"
    },
    {
      "text": "イギリス労働党結成の中心となった社会主義団体は【フェビアン協会】である。",
      "tags": [
        "No21",
        "第15章",
        "帝国主義",
        "イギリス",
        "長文分解"
      ],
      "gradingMode": "loose",
      "id": "18in8qr1jo5u7e28zp",
      "createdAt": "2026-11-02T00:44:55.000Z",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "type": "short",
      "sourceSet": "derived"
    },
    {
      "text": "武力干渉を伴うカリブ海諸国への外交を【棍棒外交】という。",
      "tags": [
        "No21",
        "第15章",
        "帝国主義",
        "アメリカ",
        "長文分解"
      ],
      "gradingMode": "loose",
      "id": "4knhf9nucm8zqjmf7b",
      "createdAt": "2026-11-02T00:44:55.000Z",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "type": "short",
      "sourceSet": "derived"
    },
    {
      "text": "ロシア語で国会を【ドゥーマ】という。",
      "tags": [
        "No21",
        "第15章",
        "帝国主義",
        "ロシア",
        "長文分解"
      ],
      "gradingMode": "loose",
      "id": "279yrwon162orfwj24",
      "createdAt": "2026-11-02T00:44:55.000Z",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "type": "short",
      "sourceSet": "derived"
    },
    {
      "text": "スタンダード石油会社を設立した実業家は【ロックフェラー】である。",
      "tags": [
        "No21",
        "第15章",
        "帝国主義",
        "アメリカ",
        "長文分解"
      ],
      "gradingMode": "loose",
      "id": "jhe8wswydl98ss06yo",
      "createdAt": "2026-11-02T00:44:55.000Z",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "type": "short",
      "sourceSet": "derived"
    },
    {
      "text": "独占規制・消費者保護などの政治を【革新主義】という。",
      "tags": [
        "No21",
        "第15章",
        "帝国主義",
        "アメリカ",
        "長文分解"
      ],
      "gradingMode": "loose",
      "id": "2757sfeies9euadjl8",
      "createdAt": "2026-11-02T00:44:55.000Z",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "type": "short",
      "sourceSet": "derived"
    },
    {
      "text": "スーダンで戦死したイギリス将軍は【ゴードン】である。",
      "tags": [
        "No21",
        "第15章",
        "帝国主義",
        "アフリカ分割",
        "長文分解"
      ],
      "gradingMode": "loose",
      "id": "w8dcam4bwps6es3mc7",
      "createdAt": "2026-11-02T00:44:55.000Z",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "type": "short",
      "sourceSet": "derived"
    },
    {
      "text": "南アフリカ戦争を推進した植民相は【ジョゼフ＝チェンバレン】である。",
      "tags": [
        "No21",
        "第15章",
        "帝国主義",
        "アフリカ分割",
        "長文分解"
      ],
      "gradingMode": "loose",
      "id": "vn8xbtcuwlv8zdfscg",
      "createdAt": "2026-11-02T00:44:55.000Z",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "type": "short",
      "sourceSet": "derived"
    },
    {
      "text": "南アフリカの人種隔離政策を【アパルトヘイト】という。",
      "tags": [
        "No21",
        "第15章",
        "帝国主義",
        "アフリカ分割",
        "長文分解"
      ],
      "gradingMode": "loose",
      "id": "r7z002pkwzdrqti0oi",
      "createdAt": "2026-11-02T00:44:55.000Z",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "type": "short",
      "sourceSet": "derived"
    },
    {
      "text": "20世紀初頭、エチオピア以外にアフリカで独立を保った国は【リベリア】である。",
      "tags": [
        "No21",
        "第15章",
        "帝国主義",
        "アフリカ分割",
        "長文分解"
      ],
      "gradingMode": "loose",
      "id": "41j92fgajt76n4vi9v",
      "createdAt": "2026-11-02T00:44:55.000Z",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "type": "short",
      "sourceSet": "derived"
    },
    {
      "text": "東部戦線でドイツ軍がロシア軍を破った戦いは【タンネンベルクの戦い】である。",
      "tags": [
        "No21",
        "第16章",
        "第一次世界大戦",
        "戦闘",
        "長文分解"
      ],
      "gradingMode": "loose",
      "id": "alq77gt0yxdx0kco66",
      "createdAt": "2026-11-02T00:44:55.000Z",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "type": "short",
      "sourceSet": "derived"
    },
    {
      "text": "ドイツの中東進出政策を【3B政策】という。",
      "tags": [
        "No21",
        "第16章",
        "第一次世界大戦",
        "ドイツ",
        "長文分解"
      ],
      "gradingMode": "loose",
      "id": "icursdoeszigphhjoh",
      "createdAt": "2026-11-02T00:44:55.000Z",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "type": "short",
      "sourceSet": "derived"
    },
    {
      "text": "ソンムの戦いでイギリス軍が初めて用いた新兵器は【戦車】である。",
      "tags": [
        "No21",
        "第16章",
        "第一次世界大戦",
        "新兵器",
        "長文分解"
      ],
      "gradingMode": "loose",
      "id": "xn2p4gvdh6zq9xueyz",
      "createdAt": "2026-11-02T00:44:55.000Z",
      "updatedAt": "2026-11-02T21:10:00+09:00",
      "masterCount": 0,
      "studyCount": 0,
      "lastStudiedAt": null,
      "lastStudyMode": null,
      "type": "short",
      "sourceSet": "derived"
    },
    {
      "text": "アメリカ参戦の直接原因は【ドイツの無制限潜水艦作戦】である。",
      "tags": [
        "No21",
        "第16章",
        "第一次世界大戦",
        "アメリカ参戦",
        "長文分解"
      ],
      "gradingMode": "loose",
      "id": "2uq5kqum809ir19kyw",
